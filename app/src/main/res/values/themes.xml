<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Nero, rosso e bianco -->
    <color name="red">#E10A1E</color>
    <color name="red_dark">#A8000F</color>
    <color name="graphite">#000000</color>
    <color name="surface">#0F0F10</color>
    <color name="surface_high">#1C1C1E</color>
    <color name="line">#2E2E31</color>
    <color name="ink">#FFFFFF</color>
    <color name="ink2">#B5B5BA</color>
    <color name="ok">#3DDC84</color>
    <color name="warn">#FFB020</color>
    <color name="ic_bg">#E10A1E</color>

    <style name="Base.Theme.Scontrini" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/red</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/red_dark</item>
        <item name="colorOnPrimaryContainer">#FFFFFF</item>
        <item name="colorSecondary">@color/red</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">@color/red_dark</item>
        <item name="colorOnSecondaryContainer">#FFFFFF</item>
        <item name="android:colorBackground">@color/graphite</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_high</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/ink2</item>
        <item name="colorOutline">@color/line</item>
        <item name="colorControlActivated">@color/red</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:windowBackground">@color/graphite</item>
        <item name="actionBarStyle">@style/Scontrini.ActionBar</item>
        <item name="alertDialogTheme">@style/Scontrini.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Scontrini.Dialog</item>
    </style>

    <style name="Theme.Scontrini" parent="Base.Theme.Scontrini" />

    <!-- barra del titolo rossa con testo bianco -->
    <style name="Scontrini.ActionBar" parent="Widget.Material3.ActionBar.Solid">
        <item name="background">@color/red</item>
        <item name="titleTextStyle">@style/Scontrini.ActionBarTitle</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Scontrini.ActionBarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Scontrini.Dialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorPrimary">@color/red</item>
        <item name="colorSurface">@color/surface_high</item>
        <item name="colorSurfaceContainerHigh">@color/surface_high</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="buttonBarPositiveButtonStyle">@style/Scontrini.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Scontrini.DialogButton</item>
    </style>

    <style name="Scontrini.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/red</item>
    </style>
</resources>
